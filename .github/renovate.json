{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "enabledManagers": [
    "custom.regex",
    "github-actions",
    "nix"
  ],
  "nix": {
    "enabled": true
  },
  "ignorePaths": [
    "/results/**"
  ],
  "packageRules": [
    {
      "description": "Auto-merge GitHub actions minor updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Caddy plugin versions",
      "managerFilePatterns": [
        "/\\.nix$/"
      ],
      "matchStrings": [
        "(?m)^# renovate: datasource=(?<datasource>github-releases)\\r?\\n\"github\\.com/(?<depName>[^@\"\\r\\n]+)@(?<currentValue>[^\"\\s\\r\\n]+)\"$"
      ]
    }
  ]
}
