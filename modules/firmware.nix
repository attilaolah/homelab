{
  config,
  lib,
  pkgs,
  ...
}: {
  options.firmware = {
    file = lib.mkOption {
      type = lib.types.path;
      description = "Path to the machine's minimal firmware inventory.";
      # This file is generated by running the command below on the host:
      # lsmod |
      #   awk 'NR > 1 { print $1 }' |
      #   while read -r module; do modinfo -F firmware "$module"; done |
      #   sort -u
    };

    src = lib.mkOption {
      type = lib.types.listOf lib.types.package;
      default = [pkgs.linux-firmware];
      defaultText = lib.literalExpression "[ pkgs.linux-firmware ]";
      description = "Ordered package sources to search for firmware files.";
    };

    wifi = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Include wireless-regdb in the firmware search sources.";
    };
  };

  config = {
    # WiFi is intentionally disabled in the cluster.
    # Most hosts have either the WiFi hardware removed, or at least the antenna severed.
    hardware.enableRedistributableFirmware = false;
    hardware.firmware = [
      (pkgs.runCommand "firmware-minimal" {nativeBuildInputs = with pkgs; [coreutils zstd];} ''
        sh ${./firmware_minimal.sh} "$out" "${config.firmware.file}" ${
          lib.escapeShellArgs (config.firmware.src ++ lib.optionals config.firmware.wifi [pkgs.wireless-regdb])
        }
      '')
    ];
  };
}
